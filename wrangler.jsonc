{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unimailbox",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "apps/web/dist",
    "run_worker_first": ["/api/*", "/health", "/setup*"],
  },
  "dev": {
    // Pinned so a stale wrangler dev on the same host cannot silently move to
    // 8788 and break the Vite proxy in apps/web/vite.config.ts.
    "port": 8787,
    "ip": "127.0.0.1",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "OUTBOUND_QUEUE",
        "queue": "unimailbox-outbound",
      },
    ],
    "consumers": [
      {
        "queue": "unimailbox-outbound",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "unimailbox-outbound-dead",
      },
    ],
  },
  "triggers": {
    "crons": ["* * * * *", "0 * * * *", "17 3 * * *"],
  },
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true,
    },
  },
  "env": {
    "preview": {
      "workers_dev": true,
      "preview_urls": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "unimailbox-preview",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "OUTBOUND_QUEUE",
            "queue": "unimailbox-preview-outbound",
          },
        ],
        "consumers": [
          {
            "queue": "unimailbox-preview-outbound",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "unimailbox-preview-outbound-dead",
          },
        ],
      },
    },
  },
}
