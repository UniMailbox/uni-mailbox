{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unimailbox",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "apps/web/dist",
    "run_worker_first": ["/api/*", "/health", "/setup*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "OUTBOUND_QUEUE",
        "queue": "unimailbox-outbound",
      },
    ],
    "consumers": [
      {
        "queue": "unimailbox-outbound",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "unimailbox-outbound-dead",
      },
    ],
  },
  "secrets_store_secrets": [
    {
      "binding": "INSTALLATION_TOKEN",
      "store_id": "unimailbox",
      "secret_name": "installation-token",
    },
    {
      "binding": "AUTH_SIGNING_KEY",
      "store_id": "unimailbox",
      "secret_name": "auth-signing-key",
    },
    {
      "binding": "CREDENTIAL_ENCRYPTION_KEY",
      "store_id": "unimailbox",
      "secret_name": "credential-encryption-key",
    },
  ],
  "triggers": {
    "crons": ["* * * * *", "0 * * * *", "17 3 * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "env": {
    "preview": {
      "workers_dev": true,
      "preview_urls": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "unimailbox-preview",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "OUTBOUND_QUEUE",
            "queue": "unimailbox-preview-outbound",
          },
        ],
        "consumers": [
          {
            "queue": "unimailbox-preview-outbound",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "unimailbox-preview-outbound-dead",
          },
        ],
      },
      "secrets_store_secrets": [
        {
          "binding": "INSTALLATION_TOKEN",
          "store_id": "unimailbox-preview",
          "secret_name": "installation-token",
        },
        {
          "binding": "AUTH_SIGNING_KEY",
          "store_id": "unimailbox-preview",
          "secret_name": "auth-signing-key",
        },
        {
          "binding": "CREDENTIAL_ENCRYPTION_KEY",
          "store_id": "unimailbox-preview",
          "secret_name": "credential-encryption-key",
        },
      ],
    },
  },
}
