          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/config/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/contracts/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/email-core/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/test-kit/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
