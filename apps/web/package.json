    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "wrangler": "^3.99.0"
  }
