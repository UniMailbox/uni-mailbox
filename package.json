{
  "name": "unimailbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:worker": "wrangler dev",
    "dev:web": "pnpm --filter @unimailbox/web dev",
    "build": "pnpm -r --if-present build",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "schema:check": "pnpm --filter @unimailbox/worker exec drizzle-kit check --config ../../drizzle.config.ts",
    "test": "pnpm test:unit && pnpm test:worker && pnpm test:integration",
    "test:unit": "pnpm --filter @unimailbox/contracts test && pnpm --filter @unimailbox/config test && pnpm --filter @unimailbox/email-core test && pnpm --filter @unimailbox/web test && vitest run apps/worker/test/unit",
    "test:worker": "vitest run apps/worker/test/worker",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "scaffold": "node scripts/scaffold.mjs",
    "db:migration:new": "node scripts/migration.mjs new",
    "db:migration:status": "node scripts/migration.mjs status",
    "db:migrate": "node scripts/migration.mjs migrate",
    "db:verify": "node scripts/migration.mjs verify",
    "release:preview": "node scripts/release.mjs preview",
    "release:production": "node scripts/release.mjs production",
    "release:rollback": "node scripts/release.mjs rollback",
    "release:verify": "node scripts/verify-deployment.mjs",
    "cf:typegen": "wrangler types apps/worker/worker-configuration.d.ts",
    "deploy": "pnpm release:production",
    "deploy:dry-run": "node scripts/dry-run.mjs",
    "deploy:r2": "wrangler deploy -c wrangler.r2.jsonc",
    "migrate:kv-to-r2": "node scripts/migrate-attachments-to-r2.mjs"
  },
  "cloudflare": {
    "bindings": {
      "INSTALLATION_TOKEN": {
        "description": "Generate a random value with at least 32 characters. This one-time token claims the first administrator."
      },
      "AUTH_SIGNING_KEY": {
        "description": "Generate a random value with at least 32 characters for access-token signing."
      },
      "CREDENTIAL_ENCRYPTION_KEY": {
        "description": "Generate a random value with at least 32 characters for AES-GCM provider credential encryption."
      }
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.6.16",
    "@playwright/test": "1.54.1",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.1",
    "vitest": "2.1.9",
    "wrangler": "4.68.0"
  }
}
